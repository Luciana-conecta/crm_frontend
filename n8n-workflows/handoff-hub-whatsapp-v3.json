{
  "name": "Handoff Hub - WhatsApp v3",
  "nodes": [

    {
      "parameters": {
        "httpMethod": "GET",
        "path": "whatsapp-handoff",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-verificacion-get",
      "name": "Webhook Verificación GET",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 120],
      "notes": "Meta llama GET para verificar el webhook. Este nodo lo maneja automáticamente."
    },

    {
      "parameters": {
        "jsCode": "// Meta envía: GET ?hub.mode=subscribe&hub.challenge=12345&hub.verify_token=mitoken\n// n8n mete los query params directamente en $json\nconst p = $input.first().json;\nconst hub = p?.query || p;\nconst challenge = hub?.['hub.challenge'] || hub?.hub?.challenge || '';\nreturn [{ json: { challenge } }];"
      },
      "id": "extraer-challenge",
      "name": "Extraer Challenge",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 120]
    },

    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.challenge }}",
        "options": { "responseCode": 200 }
      },
      "id": "responder-challenge",
      "name": "Responder Challenge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [680, 120]
    },


    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-handoff",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-meta-post",
      "name": "Webhook Meta POST",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 320],
      "notes": "Recibe los mensajes de WhatsApp desde Meta"
    },

    {
      "parameters": {
        "jsCode": "const rawInput = $input.first().json;\nconst body = rawInput.body ?? rawInput;\n\n// Resolver la estructura 'value' sea cual sea el formato\nlet value = null;\n\nif (Array.isArray(body)) {\n  // Formato que llega desde tu instancia: array directo\n  // [{ messaging_product, metadata, contacts, messages, field }]\n  value = body[0];\n} else if (body?.entry?.[0]?.changes?.[0]?.value) {\n  // Formato clásico Meta: { object, entry: [{ changes: [{ value }] }] }\n  value = body.entry[0].changes[0].value;\n} else if (body?.messaging_product === 'whatsapp') {\n  // Objeto value directo sin envolver\n  value = body;\n}\n\nif (!value) return [{ json: { tipo: 'ignorar' } }];\n\nconst mensaje  = value?.messages?.[0];\nif (!mensaje)  return [{ json: { tipo: 'ignorar' } }];\n\nconst contacto = value?.contacts?.[0];\n\nreturn [{\n  json: {\n    tipo:             'mensaje',\n    numero:           mensaje.from,\n    nombre:           contacto?.profile?.name || 'Sin nombre',\n    texto:            mensaje?.text?.body     || '',\n    tipo_mensaje:     mensaje.type,\n    timestamp:        mensaje.timestamp,\n    message_id:       mensaje.id,\n    phone_number_id:  value.metadata?.phone_number_id  || '',\n    display_phone:    value.metadata?.display_phone_number || '',\n    wa_id:            contacto?.wa_id || mensaje.from\n  }\n}];"
      },
      "id": "parsear-mensaje",
      "name": "Parsear Mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 320],
      "notes": "Maneja tanto el formato array directo como el formato clásico entry>changes>value"
    },

    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "es-ignorar",
              "leftValue": "={{ $json.tipo }}",
              "rightValue": "ignorar",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-ignorar",
      "name": "¿Ignorar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 320],
      "notes": "TRUE = ignorar (imagen, reacción, etc.). FALSE = procesar mensaje."
    },

    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{ \"status\": \"ok\" }",
        "options": { "responseCode": 200 }
      },
      "id": "responder-ignorar",
      "name": "Responder OK (ignorar)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [900, 200],
      "notes": "Meta requiere siempre un 200 OK, incluso para mensajes que no procesamos"
    },

    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO conversaciones_handoff (numero_cliente, nombre_cliente, modo, phone_number_id)\nVALUES ('{{ $json.numero }}', '{{ $json.nombre }}', 'bot', '{{ $json.phone_number_id }}')\nON CONFLICT (numero_cliente) DO UPDATE SET\n  nombre_cliente  = EXCLUDED.nombre_cliente,\n  phone_number_id = EXCLUDED.phone_number_id,\n  ultimo_mensaje  = NOW()\nRETURNING numero_cliente, modo;",
        "options": {}
      },
      "id": "upsert-db",
      "name": "Upsert Conversación DB",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [900, 380],
      "credentials": { "postgres": { "id": "TU_CREDENTIAL_ID", "name": "PostgreSQL Insignia" } }
    },

    {
      "parameters": {
        "jsCode": "const msg  = $('Parsear Mensaje').item.json;\nconst db   = $input.first().json;\nreturn [{ json: { ...msg, modo: db[0]?.modo ?? 'bot' } }];"
      },
      "id": "combinar-datos",
      "name": "Combinar Datos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 380]
    },

