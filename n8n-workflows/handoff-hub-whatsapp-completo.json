      "id": "webhook-meta",
      "name": "Webhook Meta",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "notes": "Recibe todos los webhooks de Meta (verificación + mensajes entrantes)"
    },
    {
      "parameters": {
        "jsCode": "const rawInput = $input.first().json;\n// n8n puede entregar el body en .body o directamente\nconst body = rawInput.body ?? rawInput;\n\n// Verificación de Meta (GET con ?hub.mode=subscribe)\nif (body?.hub?.mode === 'subscribe') {\n  return [{ json: { tipo: 'verificacion', challenge: body.hub.challenge } }];\n}\n\n// Resolver el objeto 'value' sea cual sea la estructura recibida\nlet value = null;\n\nif (Array.isArray(body)) {\n  // Formato que llega desde tu instancia: array directo de value objects\n  // Ej: [{ messaging_product, metadata, contacts, messages, field }]\n  value = body[0];\n} else if (body?.entry?.[0]?.changes?.[0]?.value) {\n  // Formato clásico Meta: { object, entry: [{ changes: [{ value }] }] }\n  value = body.entry[0].changes[0].value;\n} else if (body?.messaging_product === 'whatsapp') {\n  // Objeto value directo sin envolver\n  value = body;\n}\n\nif (!value) return [{ json: { tipo: 'ignorar' } }];\n\nconst mensaje = value?.messages?.[0];\nif (!mensaje) return [{ json: { tipo: 'ignorar' } }];\n\nconst contacto = value?.contacts?.[0];\n\nreturn [{\n  json: {\n    tipo: 'mensaje',\n    numero: mensaje.from,\n    nombre: contacto?.profile?.name || 'Sin nombre',\n    texto: mensaje?.text?.body || '',\n    tipo_mensaje: mensaje.type,\n    timestamp: mensaje.timestamp,\n    message_id: mensaje.id,\n    phone_number_id: value.metadata?.phone_number_id || '',\n    display_phone_number: value.metadata?.display_phone_number || '',\n    wa_id: contacto?.wa_id || mensaje.from\n  }\n}];"
      },
      "id": "parsear-mensaje",
      "name": "Parsear Mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
