    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO conversaciones_handoff (numero_cliente, nombre_cliente, modo, phone_number_id)\nVALUES ('{{ $('Parsear Mensaje').item.json.numero }}', '{{ $('Parsear Mensaje').item.json.nombre }}', 'bot', '{{ $('Parsear Mensaje').item.json.phone_number_id }}')\nON CONFLICT (numero_cliente) DO UPDATE SET\n  ultimo_mensaje = NOW(),\n  nombre_cliente = EXCLUDED.nombre_cliente,\n  phone_number_id = EXCLUDED.phone_number_id\nRETURNING modo, contexto_bot, motivo_handoff;",
