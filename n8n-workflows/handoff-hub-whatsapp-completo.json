      "parameters": {
        "jsCode": "const texto = $('Parsear Mensaje').item.json.texto.toLowerCase().trim();\n\nconst KEYWORDS_HANDOFF = [\n  'agente', 'humano', 'persona', 'operador', 'asesor',\n  'hablar con alguien', 'quiero hablar', 'necesito ayuda humana',\n  'representante', 'soporte humano', 'atención humana'\n];\n\nconst quiereAgente = KEYWORDS_HANDOFF.some(kw => texto.includes(kw));\n\nreturn [{\n  json: {\n    quiere_agente: quiereAgente,\n    numero: $('Parsear Mensaje').item.json.numero,\n    nombre: $('Parsear Mensaje').item.json.nombre,\n    texto: $('Parsear Mensaje').item.json.texto,\n    phone_number_id: $('Parsear Mensaje').item.json.phone_number_id,\n    timestamp: $('Parsear Mensaje').item.json.timestamp\n  }\n}];"
      },
